# Copie para .env.local. Só variáveis com prefixo VITE_ chegam ao navegador, e todas ficam
# públicas no bundle: nunca coloque segredo aqui.

# URL da API (backAtlus). Local: docker compose up no backAtlus.
VITE_API_URL=http://localhost:3000
# development | test | staging | production
VITE_APP_ENV=development
